# Copy to .env and fill in for a local environment. Never commit .env.
# Load it before running generated tests:  set -a; . ./.env; set +a
#
# docker-compose2.yml publishes nginx on 443 and the web container's UI app on
# 5001 (-> 5000); pgpool on 25401 (-> 5432). PostgreSQL itself publishes no
# fixed host port.

# ---- Target ---------------------------------------------------------------
# Base URL of the UI app (the SWORD blueprint is under /sword).
# nginx on 443 (https://weko3.example.org) uses a self-signed certificate and a
# host name that needs an /etc/hosts entry (127.0.0.1 weko3.example.org):
# either export SSL_CERT_FILE pointing at its CA, or use the web container
# directly. Prefer 5001 for the upload-size boundary cases, where nginx could
# answer 413 before WEKO does. SESSION_COOKIE_SECURE is true on the target:
# bearer-token API calls are unaffected, browser logins over plain http may be.
# Also set NO_PROXY=127.0.0.1 if HTTP(S)_PROXY is set.
WEKO_BASE_URL=http://127.0.0.1:5001

# Browser (UI cases only): accept the self-signed certificate of nginx. The hub's
# Python Playwright driver reads this variable (no test code edit, no NSS db).
# Leave it unset for a server with a real certificate.
# ATH_BROWSER_IGNORE_HTTPS_ERRORS=1

# Not used by plugin.yaml (database access goes through the in-container
# helpers, never psql). Kept for ad-hoc inspection only.
WEKO_DB_URL=postgresql://invenio@127.0.0.1:25401/invenio

# A search cluster used only by tests. Never the application's own instance:
# a test that wipes an index is routine, and doing it to real data is not.
# The application's own Elasticsearch is published on 29201, so 9201 is
# deliberately different: point this at a separate test cluster.
# (No connection uses it yet.)
WEKO_SEARCH_URL=http://127.0.0.1:9201

# ---- Containers (docker ps --format '{{.Names}}') -------------------------
# The web container runs the in-container helpers (docker exec) and is the
# source of the application log evidence. Default of the helper module
# when unset: weko-web-1. The others are required by the docker operations.
WEKO_WEB_CONTAINER=weko-web-1
# Source of the DB log evidence.
WEKO_DB_CONTAINER=weko-postgresql-1
WEKO_REDIS_CONTAINER=weko-redis-1
# Targets for stop/start fault injection (OP-DOCKER-STOP/START/RESTART).
WEKO_ES_CONTAINER=weko-elasticsearch-1
WEKO_WORKER_CONTAINER=weko-worker-1

# ---- Users (spec S0-01) -----------------------------------------------------
# The demo users that install.sh creates, all with the same password (the
# INVENIO_USER_PASS you gave install.sh; uspass123 in its instructions).
# seeds/bootstrap.py writes these to .env.local; see docs/BASELINE.md for the
# mapping to the roles of the specification.
SW_USER_SYSADMIN=wekosoftware@nii.ac.jp
SW_USER_REPOADMIN=repoadmin@example.org
SW_USER_COMADMIN=comadmin@example.org
SW_USER_CONTRIBUTOR=contributor@example.org
SW_USER_GENERAL=user@example.org
# On-Behalf-Of targets: allowed role / refused role (weko-items-ui refuses the
# roles in WEKO_ITEMS_UI_SHARED_USER_EXCLUDED_ROLE_NAME_LIST, default System Administrator).
SW_USER_OBO_OK=contributor@example.org
SW_USER_OBO_NG=wekosoftware@nii.ac.jp
SW_USER_PASSWORD=

# ---- OAuth tokens and clients (minted by the helpers: create_token) -------
# Never commit real values (they belong in .env.local, written by
# seeds/bootstrap.py). Tokens are recognised in saved evidence by their
# WEKO_TEST_TOKEN_ prefix and masked.
# 1..5 are the spec's tokens (1)-(5) of S0-02; all are owned by the system
# administrator and registered Direct (C-D) unless noted.
SW_TOKEN_1=
SW_TOKEN_2=
# (3) a token that was revoked after creation (SW_TOKEN_REVOKED is the same value).
SW_TOKEN_3=
# (4) is "no token presented": intentionally always empty.
SW_TOKEN_4=
SW_TOKEN_5=
SW_TOKEN_REVOKED=
# T-REV: a live token that S1-02 revokes (use it nowhere else).
SW_TOKEN_REV=
# Token (1)-equivalent for C-W (Workflow with a deletion flow), C-OBO and C-X
# (OAuth client without a SwordClient).
SW_TOKEN_W=
# Token (2) for C-W: Workflow client without the activity scope (S3-03, S3-05).
SW_TOKEN_W2=
SW_TOKEN_OBO=
SW_TOKEN_X=
# Token (1) per spec role (S2-01), owned by the user of that role.
SW_TOKEN_ROLE_SYSADMIN=
SW_TOKEN_ROLE_REPOADMIN=
SW_TOKEN_ROLE_COMADMIN=
SW_TOKEN_ROLE_CONTRIBUTOR=
SW_TOKEN_ROLE_GENERAL=
# OAuth client ids: 1 = C-D, 2 = C-W, 3 = C-OBO, X = C-X.
SW_CLIENT_ID_1=
SW_CLIENT_ID_2=
SW_CLIENT_ID_3=
SW_CLIENT_ID_X=

# ---- Workflow facts (written by seeds/bootstrap.py) -------------------------
# Item type of the C-D mapping and of the state records (30001 = simple).
SW_ITEM_TYPE_ID=30001
# The workflow created for C-W and the deletion flow it points at.
SW_WORKFLOW_ID=
SW_DELETE_FLOW_ID=

# ---- State data: recids prepared by the setup (spec S0-05) ------------------
# R1 update target; R2 DOI-bearing; R3 deleted; R4 disposable (EP5);
# R5 lock/edit/import state; R6-R8 workflow-route updates; R9 does not exist.
# R4 and R5 are consumed by use and recreated: update the value afterwards.
# The bootstrap uses 900001-900009 (R9 is never created).
SW_R1=
SW_R2=
SW_R3=
SW_R4=
SW_R5=
SW_R6=
SW_R7=
SW_R8=
SW_R9=

# ---- Redis -------------------------------------------------------------------
# DB number of the session/lock store (ACCOUNTS_SESSION_REDIS_DB_NO).
SW_REDIS_DB=1

# ---- Evidence (optional) -----------------------------------------------------
# When set, every run saves HTTP exchanges, logs and DB snapshots here
# (masked, but still never commit them; artifacts/ is gitignored).
# ATH_EVIDENCE_DIR=artifacts/evidence
